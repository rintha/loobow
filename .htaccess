# Apache equivalent of the routes in web.config (IIS).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Only redirect HTML addresses explicitly requested by a visitor.
  # Internal rewrites and default-document requests must not redirect.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(?:digital|mosaic)\.html(?:[?\s]) [NC]
  RewriteRule ^(digital|mosaic)\.html$ /$1 [R=301,L]

  RewriteRule ^(digital|mosaic)/+$ /$1 [R=301,L]

  # Keep the browser URL clean while serving the existing HTML files.
  RewriteRule ^$ index.html [L]
  RewriteRule ^(digital|mosaic)$ $1.html [L]
</IfModule>
