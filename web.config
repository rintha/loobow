<?xml version="1.0" encoding="UTF-8"?>
<!--
    Please refer to machine.config.comments for a description and
    the default values of each configuration section.

    For a full documentation of the schema please refer to
    http://go.microsoft.com/fwlink/?LinkId=42127

    To improve performance, machine.config should contain only those
    settings that differ from their defaults.
-->
<configuration>
  <system.web>
    <compilation tempDirectory="G:\PleskVhosts\icrats.in\tmp" />
  </system.web>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Check the original URL so internal rewrites never redirect in a loop. -->
        <rule name="Loobow canonical homepage" stopProcessing="true">
          <match url="^index\.html$" />
          <conditions>
            <add input="{UNENCODED_URL}" pattern="^/index\.html(?:\?|$)" />
          </conditions>
          <action type="Redirect" url="/" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Loobow canonical division URLs" stopProcessing="true">
          <match url="^(digital|mosaic)\.html$" />
          <conditions>
            <add input="{UNENCODED_URL}" pattern="^/(?:digital|mosaic)\.html(?:\?|$)" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Loobow remove division trailing slash" stopProcessing="true">
          <match url="^(digital|mosaic)/+$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Loobow welcome page" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="index.html" appendQueryString="true" />
        </rule>
        <rule name="Loobow division pages" stopProcessing="true">
          <match url="^(digital|mosaic)$" />
          <action type="Rewrite" url="{R:1}.html" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
