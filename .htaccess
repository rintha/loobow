# Optional Apache redirects for old clean URLs. HTML pages work without this file.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Only redirect HTML addresses explicitly requested by a visitor.
  # Internal rewrites and default-document requests must not redirect.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteRule ^(digital|mosaic)/*$ /$1.html [R=301,L]

  # The welcome page remains at the domain root.
  RewriteRule ^$ index.html [L]
</IfModule>
